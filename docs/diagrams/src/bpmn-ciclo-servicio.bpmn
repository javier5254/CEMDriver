<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_CicloServicio" targetNamespace="https://cmedriver.local/bpmn" exporter="CMEDriver docs (generado a mano)" exporterVersion="1.0">
  <bpmn:message id="Msg_SolicitudAPI" name="Solicitud de servicio vía API" />
  <bpmn:message id="Msg_Webhook" name="Evento de webhook firmado" />
  <bpmn:collaboration id="Collab_CicloServicio">
    <bpmn:documentation>Ciclo de vida de un servicio de mensajería en CMEDriver (Entrega y Recolección), modelado a partir de backend/services/views.py, tracking/views.py, integrations/services.py, chatbot/llm.py y optimization/views.py.</bpmn:documentation>
    <bpmn:participant id="P_CMEDriver" name="CMEDriver" processRef="Proc_CicloServicio" />
    <bpmn:participant id="P_Integrador" name="Sistema integrador (cliente de la API con X-API-Key / receptor de webhooks)" />
    <bpmn:participant id="P_Nominatim" name="Nominatim (OpenStreetMap)" />
    <bpmn:messageFlow id="MF01" name="Crear servicio: POST /api/servicios/ (X-API-Key)" sourceRef="P_Integrador" targetRef="SE_API" />
    <bpmn:messageFlow id="MF02" name="HTTP 401" sourceRef="EE_Rechazo401" targetRef="P_Integrador" />
    <bpmn:messageFlow id="MF03" name="POST servicio.creado (firma HMAC)" sourceRef="SND_WebhookCreado" targetRef="P_Integrador" />
    <bpmn:messageFlow id="MF04" name="POST servicio.asignado" sourceRef="SND_WebhookAsignado" targetRef="P_Integrador" />
    <bpmn:messageFlow id="MF07" name="POST servicio.recolectado" sourceRef="SND_WebhookRecolectado" targetRef="P_Integrador" />
    <bpmn:messageFlow id="MF08" name="POST servicio.entregado" sourceRef="SND_WebhookEntregado" targetRef="P_Integrador" />
    <bpmn:messageFlow id="MF09" name="POST servicio.novedad" sourceRef="SND_WebhookNovedad" targetRef="P_Integrador" />
    <bpmn:messageFlow id="MF10" name="POST servicio.devuelto" sourceRef="SND_WebhookDevuelto" targetRef="P_Integrador" />
    <bpmn:messageFlow id="MF05" name="Geocodificar dirección (GET /search)" sourceRef="ST_Optimizar" targetRef="P_Nominatim" />
    <bpmn:messageFlow id="MF06" name="lat, lng (o sin resultado)" sourceRef="P_Nominatim" targetRef="ST_Optimizar" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_CicloServicio" name="Ciclo de vida de un servicio de mensajería" isExecutable="false">
    <bpmn:laneSet id="LaneSet_CME">
      <bpmn:lane id="Lane_Cliente" name="Cliente">
        <bpmn:flowNodeRef>SE_Cliente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_QueSolicita</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_Comprar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_Planificar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Alistador" name="Administrador / Alistador">
        <bpmn:flowNodeRef>SE_Alistador</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_Registrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_AsignarRuta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Optimizar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_PedirOrden</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Motorizado" name="Motorizado (app móvil)">
        <bpmn:flowNodeRef>UT_ConsultarRuta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_TipoServicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_RecibirCentro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_MergeTransito</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_IniciarTransito</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PG_Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MT_Visita</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_MergeGPS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IE_Cada8s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_EnviarGPS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PG_Fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Resultado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_TipoCierre</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_Evidencia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_ConfirmarEntrega</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_RegistrarNovedad</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sistema" name="Sistema CMEDriver (backend)">
        <bpmn:flowNodeRef>SE_API</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_AutenticarKey</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_KeyValida</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE_Rechazo401</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_MergeCreacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_ValidarDatos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_DatosValidos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE_Rechazo400</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_ValidarAgenda</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_AgendaValida</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE_RechazoAgenda</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_CrearCompra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_MergeValidas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_RegistrarCreado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SND_WebhookCreado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_MergeCreado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_PasarAsignado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SND_WebhookAsignado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_Optimizar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_MergeOpt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_PasarRecibido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_PasarTransito</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_DifundirGPS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_SigueTransito</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_ValidarEvidencia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_EvidenciaOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_PasarRecolectado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SND_WebhookRecolectado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE_Recolectado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_PasarEntregado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SND_WebhookEntregado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE_Entregado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_GuardarNovedad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SND_WebhookNovedad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_AccionNovedad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SND_WebhookDevuelto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EE_Devuelto</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="SE_Cliente" name="Cliente necesita un servicio">
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="GW_QueSolicita" name="¿Qué solicita el cliente?">
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
      <bpmn:outgoing>F03</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UT_Comprar" name="Comprar producto por chatbot [RF-18, RF-22, RF-23]">
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UT_Planificar" name="Planificar recolección (app o chatbot) [RF-17, RF-22]">
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="SE_Alistador" name="Pedido recibido en el centro">
      <bpmn:outgoing>F06</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UT_Registrar" name="Registrar servicio manual [RF-05]">
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="SE_API" name="Solicitud POST /api/servicios/ con X-API-Key">
      <bpmn:outgoing>F08</bpmn:outgoing>
      <bpmn:messageEventDefinition id="SE_API_med" messageRef="Msg_SolicitudAPI" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="ST_AutenticarKey" name="Autenticar API Key como Alistador [RF-06, RN-08]">
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_KeyValida" name="¿API Key válida y activa?">
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EE_Rechazo401" name="Rechazada (HTTP 401)">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:messageEventDefinition id="EE_Rechazo401_med" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GW_MergeCreacion">
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ST_ValidarDatos" name="Validar dirección obligatoria según tipo [RN-13]">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_DatosValidos" name="¿Datos válidos?">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EE_Rechazo400" name="Rechazada (HTTP 400)">
      <bpmn:incoming>F15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ST_ValidarAgenda" name="Validar cobertura, leadtime y día hábil [RN-03, RN-15]">
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_AgendaValida" name="¿Zona y fecha válidas?">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EE_RechazoAgenda" name="Solicitud rechazada (HTTP 400)">
      <bpmn:incoming>F17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ST_CrearCompra" name="Crear ENTREGA y procesar pago simulado [RF-23, RN-04, RN-16]">
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_MergeValidas">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ST_RegistrarCreado" name="Registrar servicio en estado CREADO [RF-05, RN-09]">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="SND_WebhookCreado" name="Disparar webhook servicio.creado [RF-25, RN-07]" messageRef="Msg_Webhook">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="GW_MergeCreado">
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UT_AsignarRuta" name="Crear/seleccionar ruta y asignar servicio [RF-07, RN-10]">
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:outgoing>F24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ST_PasarAsignado" name="Pasar a ASIGNADO (solo desde CREADO) [RN-09, RN-10]">
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:outgoing>F25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="SND_WebhookAsignado" name="Disparar webhook servicio.asignado [RF-25, RN-07]" messageRef="Msg_Webhook">
      <bpmn:incoming>F25</bpmn:incoming>
      <bpmn:outgoing>F26</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="GW_Optimizar" name="¿Pedir orden sugerido de la ruta?">
      <bpmn:incoming>F26</bpmn:incoming>
      <bpmn:outgoing>F27</bpmn:outgoing>
      <bpmn:outgoing>F28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UT_PedirOrden" name="Solicitar orden sugerido de visita [RF-21]">
      <bpmn:incoming>F27</bpmn:incoming>
      <bpmn:outgoing>F29</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ST_Optimizar" name="Geocodificar y ordenar por vecino más cercano [RF-21]">
      <bpmn:incoming>F29</bpmn:incoming>
      <bpmn:outgoing>F30</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_MergeOpt">
      <bpmn:incoming>F28</bpmn:incoming>
      <bpmn:incoming>F30</bpmn:incoming>
      <bpmn:outgoing>F31</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UT_ConsultarRuta" name="Consultar servicios de su ruta [RF-09, RN-11]">
      <bpmn:incoming>F31</bpmn:incoming>
      <bpmn:outgoing>F32</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_TipoServicio" name="¿Tipo de servicio?">
      <bpmn:incoming>F32</bpmn:incoming>
      <bpmn:outgoing>F33</bpmn:outgoing>
      <bpmn:outgoing>F34</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UT_RecibirCentro" name="Recibir paquete en el centro [RF-10, RN-01]">
      <bpmn:incoming>F33</bpmn:incoming>
      <bpmn:outgoing>F35</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ST_PasarRecibido" name="Pasar a RECIBIDO_CENTRO [RN-01, RN-09, RN-11]">
      <bpmn:incoming>F35</bpmn:incoming>
      <bpmn:outgoing>F36</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_MergeTransito">
      <bpmn:incoming>F34</bpmn:incoming>
      <bpmn:incoming>F36</bpmn:incoming>
      <bpmn:incoming>F68</bpmn:incoming>
      <bpmn:outgoing>F37</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UT_IniciarTransito" name="Iniciar tránsito [RF-12, RN-11]">
      <bpmn:incoming>F37</bpmn:incoming>
      <bpmn:outgoing>F38</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ST_PasarTransito" name="Validar estado de origen y pasar a EN_TRANSITO [RN-01, RN-09]">
      <bpmn:incoming>F38</bpmn:incoming>
      <bpmn:outgoing>F39</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="PG_Inicio">
      <bpmn:incoming>F39</bpmn:incoming>
      <bpmn:outgoing>F40</bpmn:outgoing>
      <bpmn:outgoing>F41</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:manualTask id="MT_Visita" name="Desplazarse y atender la visita">
      <bpmn:incoming>F40</bpmn:incoming>
      <bpmn:outgoing>F48</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="GW_MergeGPS">
      <bpmn:incoming>F41</bpmn:incoming>
      <bpmn:incoming>F46</bpmn:incoming>
      <bpmn:outgoing>F42</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="IE_Cada8s" name="Cada 8 s">
      <bpmn:incoming>F42</bpmn:incoming>
      <bpmn:outgoing>F43</bpmn:outgoing>
      <bpmn:timerEventDefinition id="IE_Cada8s_ted">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT8S</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="ST_EnviarGPS" name="Enviar posición GPS desde la app [RF-14, RN-11]">
      <bpmn:incoming>F43</bpmn:incoming>
      <bpmn:outgoing>F44</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ST_DifundirGPS" name="Guardar posición y difundir por WebSocket [RF-14, RF-27]">
      <bpmn:incoming>F44</bpmn:incoming>
      <bpmn:outgoing>F45</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_SigueTransito" name="¿Visita en curso (EN_TRANSITO)?">
      <bpmn:incoming>F45</bpmn:incoming>
      <bpmn:outgoing>F46</bpmn:outgoing>
      <bpmn:outgoing>F47</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="PG_Fin">
      <bpmn:incoming>F47</bpmn:incoming>
      <bpmn:incoming>F48</bpmn:incoming>
      <bpmn:outgoing>F49</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="GW_Resultado" name="¿Se pudo entregar / recolectar?">
      <bpmn:incoming>F49</bpmn:incoming>
      <bpmn:outgoing>F50</bpmn:outgoing>
      <bpmn:outgoing>F51</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_TipoCierre" name="¿Tipo de servicio?">
      <bpmn:incoming>F50</bpmn:incoming>
      <bpmn:outgoing>F52</bpmn:outgoing>
      <bpmn:outgoing>F53</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UT_Evidencia" name="Capturar foto y firma, y cerrar [RF-11, RN-02]">
      <bpmn:incoming>F52</bpmn:incoming>
      <bpmn:incoming>F56</bpmn:incoming>
      <bpmn:outgoing>F54</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ST_ValidarEvidencia" name="Validar foto y firma [RN-02]">
      <bpmn:incoming>F54</bpmn:incoming>
      <bpmn:outgoing>F55</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_EvidenciaOK" name="¿Evidencia completa?">
      <bpmn:incoming>F55</bpmn:incoming>
      <bpmn:outgoing>F56</bpmn:outgoing>
      <bpmn:outgoing>F57</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ST_PasarRecolectado" name="Guardar evidencia y pasar a RECOLECTADO [RF-11, RN-17]">
      <bpmn:incoming>F57</bpmn:incoming>
      <bpmn:outgoing>F58</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="SND_WebhookRecolectado" name="Disparar webhook servicio.recolectado [RF-25]" messageRef="Msg_Webhook">
      <bpmn:incoming>F58</bpmn:incoming>
      <bpmn:outgoing>F59</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EE_Recolectado" name="Servicio RECOLECTADO">
      <bpmn:incoming>F59</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="UT_ConfirmarEntrega" name="Confirmar entrega (cerrar servicio) [RF-12]">
      <bpmn:incoming>F53</bpmn:incoming>
      <bpmn:outgoing>F60</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ST_PasarEntregado" name="Pasar a ENTREGADO [RF-12, RN-09, RN-12]">
      <bpmn:incoming>F60</bpmn:incoming>
      <bpmn:outgoing>F61</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="SND_WebhookEntregado" name="Disparar webhook servicio.entregado [RF-25]" messageRef="Msg_Webhook">
      <bpmn:incoming>F61</bpmn:incoming>
      <bpmn:outgoing>F62</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EE_Entregado" name="Servicio ENTREGADO">
      <bpmn:incoming>F62</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="UT_RegistrarNovedad" name="Registrar novedad: tipo, detalle y acción [RF-13, RN-05]">
      <bpmn:incoming>F51</bpmn:incoming>
      <bpmn:outgoing>F63</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ST_GuardarNovedad" name="Guardar novedad y fijar estado NOVEDAD o DEVUELTO [RN-05, RN-12]">
      <bpmn:incoming>F63</bpmn:incoming>
      <bpmn:outgoing>F64</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="SND_WebhookNovedad" name="Disparar webhook servicio.novedad [RF-25]" messageRef="Msg_Webhook">
      <bpmn:incoming>F64</bpmn:incoming>
      <bpmn:outgoing>F65</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="GW_AccionNovedad" name="¿Acción de la novedad?">
      <bpmn:incoming>F65</bpmn:incoming>
      <bpmn:outgoing>F66</bpmn:outgoing>
      <bpmn:outgoing>F68</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="SND_WebhookDevuelto" name="Disparar webhook servicio.devuelto [RF-25]" messageRef="Msg_Webhook">
      <bpmn:incoming>F66</bpmn:incoming>
      <bpmn:outgoing>F67</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EE_Devuelto" name="Servicio DEVUELTO">
      <bpmn:incoming>F67</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="SE_Cliente" targetRef="GW_QueSolicita" />
    <bpmn:sequenceFlow id="F02" name="Compra" sourceRef="GW_QueSolicita" targetRef="UT_Comprar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">opcion == "comprar"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F03" name="Recolección" sourceRef="GW_QueSolicita" targetRef="UT_Planificar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">opcion == "recoleccion"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F04" sourceRef="UT_Comprar" targetRef="ST_CrearCompra" />
    <bpmn:sequenceFlow id="F05" sourceRef="UT_Planificar" targetRef="ST_ValidarAgenda" />
    <bpmn:sequenceFlow id="F06" sourceRef="SE_Alistador" targetRef="UT_Registrar" />
    <bpmn:sequenceFlow id="F07" sourceRef="UT_Registrar" targetRef="GW_MergeCreacion" />
    <bpmn:sequenceFlow id="F08" sourceRef="SE_API" targetRef="ST_AutenticarKey" />
    <bpmn:sequenceFlow id="F09" sourceRef="ST_AutenticarKey" targetRef="GW_KeyValida" />
    <bpmn:sequenceFlow id="F10" name="Sí" sourceRef="GW_KeyValida" targetRef="GW_MergeCreacion">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">api_key.activa</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F11" name="No" sourceRef="GW_KeyValida" targetRef="EE_Rechazo401">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not api_key.activa</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F12" sourceRef="GW_MergeCreacion" targetRef="ST_ValidarDatos" />
    <bpmn:sequenceFlow id="F13" sourceRef="ST_ValidarDatos" targetRef="GW_DatosValidos" />
    <bpmn:sequenceFlow id="F14" name="Sí" sourceRef="GW_DatosValidos" targetRef="GW_MergeValidas">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">serializer.is_valid()</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F15" name="No" sourceRef="GW_DatosValidos" targetRef="EE_Rechazo400">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not serializer.is_valid()</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F16" sourceRef="ST_ValidarAgenda" targetRef="GW_AgendaValida" />
    <bpmn:sequenceFlow id="F17" name="No" sourceRef="GW_AgendaValida" targetRef="EE_RechazoAgenda">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">fecha &lt; hoy + leadtime or dia no habil or sin cobertura</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F18" name="Sí" sourceRef="GW_AgendaValida" targetRef="GW_MergeValidas">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">agenda valida</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F19" sourceRef="GW_MergeValidas" targetRef="ST_RegistrarCreado" />
    <bpmn:sequenceFlow id="F20" sourceRef="ST_RegistrarCreado" targetRef="SND_WebhookCreado" />
    <bpmn:sequenceFlow id="F21" sourceRef="SND_WebhookCreado" targetRef="GW_MergeCreado" />
    <bpmn:sequenceFlow id="F22" sourceRef="ST_CrearCompra" targetRef="GW_MergeCreado" />
    <bpmn:sequenceFlow id="F23" sourceRef="GW_MergeCreado" targetRef="UT_AsignarRuta" />
    <bpmn:sequenceFlow id="F24" sourceRef="UT_AsignarRuta" targetRef="ST_PasarAsignado" />
    <bpmn:sequenceFlow id="F25" sourceRef="ST_PasarAsignado" targetRef="SND_WebhookAsignado" />
    <bpmn:sequenceFlow id="F26" sourceRef="SND_WebhookAsignado" targetRef="GW_Optimizar" />
    <bpmn:sequenceFlow id="F27" name="Sí" sourceRef="GW_Optimizar" targetRef="UT_PedirOrden">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">alistador solicita optimizacion</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F28" name="No" sourceRef="GW_Optimizar" targetRef="GW_MergeOpt">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">no se solicita</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F29" sourceRef="UT_PedirOrden" targetRef="ST_Optimizar" />
    <bpmn:sequenceFlow id="F30" sourceRef="ST_Optimizar" targetRef="GW_MergeOpt" />
    <bpmn:sequenceFlow id="F31" sourceRef="GW_MergeOpt" targetRef="UT_ConsultarRuta" />
    <bpmn:sequenceFlow id="F32" sourceRef="UT_ConsultarRuta" targetRef="GW_TipoServicio" />
    <bpmn:sequenceFlow id="F33" name="ENTREGA" sourceRef="GW_TipoServicio" targetRef="UT_RecibirCentro">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">tipo == ENTREGA</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F34" name="RECOLECCIÓN" sourceRef="GW_TipoServicio" targetRef="GW_MergeTransito">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">tipo == RECOLECCION</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F35" sourceRef="UT_RecibirCentro" targetRef="ST_PasarRecibido" />
    <bpmn:sequenceFlow id="F36" sourceRef="ST_PasarRecibido" targetRef="GW_MergeTransito" />
    <bpmn:sequenceFlow id="F37" sourceRef="GW_MergeTransito" targetRef="UT_IniciarTransito" />
    <bpmn:sequenceFlow id="F38" sourceRef="UT_IniciarTransito" targetRef="ST_PasarTransito" />
    <bpmn:sequenceFlow id="F39" sourceRef="ST_PasarTransito" targetRef="PG_Inicio" />
    <bpmn:sequenceFlow id="F40" sourceRef="PG_Inicio" targetRef="MT_Visita" />
    <bpmn:sequenceFlow id="F41" sourceRef="PG_Inicio" targetRef="GW_MergeGPS" />
    <bpmn:sequenceFlow id="F42" sourceRef="GW_MergeGPS" targetRef="IE_Cada8s" />
    <bpmn:sequenceFlow id="F43" sourceRef="IE_Cada8s" targetRef="ST_EnviarGPS" />
    <bpmn:sequenceFlow id="F44" sourceRef="ST_EnviarGPS" targetRef="ST_DifundirGPS" />
    <bpmn:sequenceFlow id="F45" sourceRef="ST_DifundirGPS" targetRef="GW_SigueTransito" />
    <bpmn:sequenceFlow id="F46" name="Sí" sourceRef="GW_SigueTransito" targetRef="GW_MergeGPS">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">servicio.estado == EN_TRANSITO</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F47" name="No (cerró o registró novedad)" sourceRef="GW_SigueTransito" targetRef="PG_Fin">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">servicio.estado != EN_TRANSITO</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F48" sourceRef="MT_Visita" targetRef="PG_Fin" />
    <bpmn:sequenceFlow id="F49" sourceRef="PG_Fin" targetRef="GW_Resultado" />
    <bpmn:sequenceFlow id="F50" name="Sí" sourceRef="GW_Resultado" targetRef="GW_TipoCierre">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">visita exitosa</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F51" name="No: hay novedad" sourceRef="GW_Resultado" targetRef="UT_RegistrarNovedad">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">visita fallida</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F52" name="RECOLECCIÓN" sourceRef="GW_TipoCierre" targetRef="UT_Evidencia">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">tipo == RECOLECCION</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F53" name="ENTREGA" sourceRef="GW_TipoCierre" targetRef="UT_ConfirmarEntrega">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">tipo == ENTREGA</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F54" sourceRef="UT_Evidencia" targetRef="ST_ValidarEvidencia" />
    <bpmn:sequenceFlow id="F55" sourceRef="ST_ValidarEvidencia" targetRef="GW_EvidenciaOK" />
    <bpmn:sequenceFlow id="F56" name="No (HTTP 400)" sourceRef="GW_EvidenciaOK" targetRef="UT_Evidencia">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">falta foto o firma</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F57" name="Sí" sourceRef="GW_EvidenciaOK" targetRef="ST_PasarRecolectado">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">foto and firma</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F58" sourceRef="ST_PasarRecolectado" targetRef="SND_WebhookRecolectado" />
    <bpmn:sequenceFlow id="F59" sourceRef="SND_WebhookRecolectado" targetRef="EE_Recolectado" />
    <bpmn:sequenceFlow id="F60" sourceRef="UT_ConfirmarEntrega" targetRef="ST_PasarEntregado" />
    <bpmn:sequenceFlow id="F61" sourceRef="ST_PasarEntregado" targetRef="SND_WebhookEntregado" />
    <bpmn:sequenceFlow id="F62" sourceRef="SND_WebhookEntregado" targetRef="EE_Entregado" />
    <bpmn:sequenceFlow id="F63" sourceRef="UT_RegistrarNovedad" targetRef="ST_GuardarNovedad" />
    <bpmn:sequenceFlow id="F64" sourceRef="ST_GuardarNovedad" targetRef="SND_WebhookNovedad" />
    <bpmn:sequenceFlow id="F65" sourceRef="SND_WebhookNovedad" targetRef="GW_AccionNovedad" />
    <bpmn:sequenceFlow id="F66" name="DEVOLVER_A_CENTRO" sourceRef="GW_AccionNovedad" targetRef="SND_WebhookDevuelto">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">accion == DEVOLVER_A_CENTRO</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F67" sourceRef="SND_WebhookDevuelto" targetRef="EE_Devuelto" />
    <bpmn:sequenceFlow id="F68" name="REINTENTAR (estado NOVEDAD): volver a iniciar tránsito" sourceRef="GW_AccionNovedad" targetRef="GW_MergeTransito">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">accion == REINTENTAR</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:textAnnotation id="TA_Compra">
      <bpmn:text>H-09 y H-12: la compra por chatbot crea la ENTREGA sin disparar servicio.creado ni descontar stock (H-09) y la deja en CREADO aunque el pago sea RECHAZADO (H-12).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_TA_Compra" sourceRef="TA_Compra" targetRef="ST_CrearCompra" associationDirection="None" />
    <bpmn:textAnnotation id="TA_H04">
      <bpmn:text>H-04: la creación manual o por API no valida cobertura ni leadtime (RN-03 solo aplica a planificar).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_TA_H04" sourceRef="TA_H04" targetRef="ST_ValidarDatos" associationDirection="None" />
    <bpmn:textAnnotation id="TA_H09b">
      <bpmn:text>H-09: recibir-en-centro e iniciar-tránsito cambian el estado pero no disparan webhook.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_TA_H09b" sourceRef="TA_H09b" targetRef="ST_PasarRecibido" associationDirection="None" />
    <bpmn:textAnnotation id="TA_H02">
      <bpmn:text>H-02: una ENTREGA en ASIGNADO con novedad REINTENTAR pasa a NOVEDAD y puede iniciar tránsito sin pasar por RECIBIDO_CENTRO (RN-01).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_TA_H02" sourceRef="TA_H02" targetRef="ST_PasarTransito" associationDirection="None" />
    <bpmn:textAnnotation id="TA_Tracking">
      <bpmn:text>Mientras el servicio está EN_TRANSITO, el Cliente ve la posición del motorizado en su mapa por WebSocket ws/tracking/{id}/ (polling cada 8 s si el socket falla) y el destino geocodificado [RF-15, RF-27, RF-28]; además puede chatear con el motorizado [RF-16].</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TA_Reintentar">
      <bpmn:text>Hallazgo H-11: el backend permite NOVEDAD → EN_TRANSITO, pero la app del motorizado no muestra "Iniciar tránsito" ni "Novedad" para un servicio en NOVEDAD.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TA_Novedad">
      <bpmn:text>El backend también acepta novedades desde ASIGNADO y RECIBIDO_CENTRO (RN-09); aquí se modela el caso típico: falla la visita.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_TA_Novedad" sourceRef="TA_Novedad" targetRef="UT_RegistrarNovedad" associationDirection="None" />
  </bpmn:process>
