# Copiar a backend/.env (o exportar en el entorno) y ajustar. NO subir .env al repositorio.
# En desarrollo local todas son opcionales: hay valores por defecto seguros solo para dev.

# Obligatoria cuando DJANGO_DEBUG=False. Generar con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
# Lista separada por comas, ej: api.midominio.com,localhost
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8100
FRONTEND_URL=http://localhost:4200
# Backend de correo: consola en dev; SMTP real en produccion
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=CMEDriver <noreply@cmedriver.local>
